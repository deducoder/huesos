#!/usr/bin/env bash
# Quality gates for this project — the commit gate.
#
# Run this before every commit. Nothing enforces that — a red check will not
# stop a commit — so run it yourself while working.
# Keep it FAST: lint, format, types, unit tests. Anything that needs services
# running, the network, or minutes belongs in ./scripts/check-integration and
# runs at push/PR time instead.
#
# Contract: exit 0 = green, non-zero = red. Binary and scriptable on purpose,
# even with nothing consuming it today.
#
# Usage: ./scripts/check

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# Uncomment if the tests read configuration from a dotenv file:
# set -a; [ -f .env ] && . ./.env 2>/dev/null; set +a

fail=0
run() { printf '\n· %s\n' "$*"; "$@" || fail=1; }

# --- Replace with this project's actual commands -----------------------------
# Use the exact incantation this project needs (`uv run …`, `npm run …`,
# `go …`, `dotnet …`). If a gate does not apply, delete its line.

run {lint command}
run {format check command}
run {type check command}
run {unit test command}          # scoped to unit tests — no integration/E2E
# -----------------------------------------------------------------------------

if [ "$fail" -ne 0 ]; then
  printf '\n✗ gates failed\n'
  exit 1
fi
printf '\n✓ gates passed\n'
